# AgentBridge does not read API keys itself. Provider CLIs use their own
# authentication. Copy to .env only if your provider CLI expects these variables,
# and never commit the .env file.

# Claude Code can use an API key instead of an interactive login:
# ANTHROPIC_API_KEY=

# Optional: point AgentBench at a different benchmarks directory.
# AGENTBENCH_DIR=./benchmarks
